{
  // Configuração do Cloudflare Workers (lida pelo "npx wrangler deploy")
  "name": "pharmalens",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  // Não apaga as variáveis cadastradas no painel do Cloudflare a cada deploy
  "keep_vars": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
